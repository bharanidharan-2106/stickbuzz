<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ================= TOOLBAR ================= -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:paddingTop="24dp"
            android:background="@color/primaryOrange"
            app:title="StickBuzz"
            app:titleTextColor="@android:color/white"
            app:navigationIconTint="@android:color/white"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- ================= SCORE ROW ================= -->
        <LinearLayout
            android:id="@+id/layoutScoreRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtTeamAName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Team A"
                android:textStyle="bold"
                android:textSize="16sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/txtScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 - 0"
                android:textSize="30sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"/>

            <TextView
                android:id="@+id/txtTeamBName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Team B"
                android:textStyle="bold"
                android:textSize="16sp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- ================= EVENTS (LEFT / RIGHT) ================= -->
        <LinearLayout
            android:id="@+id/layoutEvents"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/layoutScoreRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/layoutTeamAEvents"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"/>

            <LinearLayout
                android:id="@+id/layoutTeamBEvents"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end"/>
        </LinearLayout>

        <!-- ================= MATCH INFO CENTER ================= -->
        <LinearLayout
            android:id="@+id/layoutMatchInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/layoutEvents"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtQuarter"
                android:text="Quarter: 1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/txtStatus"
                android:text="Status: SCHEDULED"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="14sp"/>
        </LinearLayout>
        <TextView
            android:id="@+id/txtAdminMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="#B00020"
            android:textStyle="bold"
            android:visibility="gone"
            android:padding="12dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/layoutMatchInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <!-- ================= QUARTER DURATION ================= -->
        <Spinner
            android:id="@+id/spinnerQuarterDuration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/txtAdminMessage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- ================= SQUAD HEADER ================= -->
        <TextView
            android:id="@+id/txtSquadTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SQUAD ▼"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/spinnerQuarterDuration"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- ================= SQUAD CONTAINER ================= -->
        <LinearLayout
            android:id="@+id/layoutSquadContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/txtSquadTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/layoutTeamASquad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"/>

            <Space
                android:layout_width="16dp"
                android:layout_height="match_parent"/>

            <LinearLayout
                android:id="@+id/layoutTeamBSquad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"/>
        </LinearLayout>

        <!-- ================= BUTTONS ================= -->
        <!-- BUTTON ROW 1 -->
        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/layoutSquadContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btnAddPlayerA"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="Team A Player"
                android:textColor="@color/white"
                android:backgroundTint="@color/primaryOrange"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnAddPlayerB"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="Team B Player"
                android:textColor="@color/white"
                android:backgroundTint="@color/primaryOrange"/>
        </LinearLayout>

        <!-- BUTTON ROW 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:id="@+id/row2"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/row1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btnStartLive"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="Start Live"
                android:textColor="@color/white"
                android:backgroundTint="@color/primaryOrange"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnNextQuarter"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="Next Quarter"
                android:textColor="@color/white"
                android:backgroundTint="@color/darkOrange"/>
        </LinearLayout>

        <!-- BUTTON ROW 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:id="@+id/row3"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/row2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btnAddGoal"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="Add Goal"
                android:textColor="@color/white"
                android:backgroundTint="@color/primaryOrange"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnAddCard"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="Add Card"
                android:textColor="@color/white"
                android:backgroundTint="@color/darkOrange"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnEndMatch"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="End Match"
            android:textColor="@color/white"
            android:backgroundTint="#B00020"
            android:layout_margin="16dp"
            android:layout_marginBottom="40dp"
            app:layout_constraintTop_toBottomOf="@id/row3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
