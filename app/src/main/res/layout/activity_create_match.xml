<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="85dp"
        android:paddingTop="28dp"
        android:background="@color/primaryOrange"
        android:theme="@style/ToolbarTheme"
        app:title="StickBuzz"
        app:titleTextColor="@android:color/white"
        app:navigationIconTint="@android:color/white"
        app:popupTheme="@style/ToolbarPopupTheme"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtTitle"
        android:text="Create Match"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/primaryOrange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"/>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- TEAM A -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutTeamA"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <AutoCompleteTextView
                    android:id="@+id/etTeamA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Team A Name"
                    android:inputType="textCapWords"
                    android:completionThreshold="1"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- TEAM B -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutTeamB"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <AutoCompleteTextView
                    android:id="@+id/etTeamB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Team B Name"
                    android:inputType="textCapWords"
                    android:completionThreshold="1"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- DESCRIPTION -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutDescription"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Match Type (Friendly / League / Practice)"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- VENUE -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutVenue"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVenue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Venue"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- DATE -->
            <Button
                android:id="@+id/btnSelectDate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Select Match Date"
                android:backgroundTint="@color/lightOrange"
                android:textColor="@color/white"
                android:layout_marginTop="16dp"/>

            <!-- TIME (12 Hour) -->
            <Button
                android:id="@+id/btnSelectTime"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Select Match Time"
                android:backgroundTint="@color/darkOrange"
                android:textColor="@color/white"
                android:layout_marginTop="12dp"/>

            <!-- CREATE -->
            <Button
                android:id="@+id/btnCreate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="CREATE MATCH"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/primaryOrange"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="40dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
