<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ========================================= -->
    <!-- Base Theme (Force Light Mode) -->
    <!-- ========================================= -->
    <style name="Base.Theme.StickBuzz" parent="Theme.Material3.Light.NoActionBar">

        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/primaryOrange</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Disable Dark Mode Completely -->
        <item name="android:forceDarkAllowed">false</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/primaryOrange</item>
        <item name="android:windowLightStatusBar">false</item>

    </style>

    <!-- ========================================= -->
    <!-- Main App Theme -->
    <!-- ========================================= -->
    <style name="Theme.StickBuzz" parent="Base.Theme.StickBuzz"/>

    <!-- ========================================= -->
    <!-- Toolbar Theme (White Text + Icons) -->
    <!-- ========================================= -->
    <style name="ToolbarTheme" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@android:color/white</item>
    </style>

    <!-- Popup Menu Theme (3 Dot Menu) -->
    <style name="ToolbarPopupTheme" parent="ThemeOverlay.AppCompat.Light"/>

</resources>